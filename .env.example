# 이 파일을 복사해 `.env`로 만들고 실제 키를 넣으세요.
# cp .env.example .env  (PowerShell: Copy-Item .env.example .env)
ANTHROPIC_API_KEY=sk-ant-...
# 선택: 프록시 포트 (기본 8787)
# PROXY_PORT=8787

# ── 실데이터 연동 (없으면 해당 소스는 '키 미설정'으로 표시되고 시뮬레이션 값 유지) ──
# 공공데이터포털(data.go.kr) 서비스키 — 기상청 초단기실황·기상특보 (인천 격자 nx55/ny124)
#   발급: data.go.kr 로그인 → "기상청_단기예보 조회서비스", "기상청_기상특보 조회서비스" 활용신청(즉시 승인)
#   인코딩키/디코딩키 어느 쪽을 넣어도 동작
DATA_GO_KR_KEY=
# 관세청 UNI-PASS 화물통관진행정보 인증키 — BL/화물관리번호로 통관 진행단계 조회
#   발급: unipass.customs.go.kr → Open API → 인증키 신청 (cargCsclPrgsInfoQry)
UNIPASS_KEY=
